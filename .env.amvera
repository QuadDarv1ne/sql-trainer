# ============================================
# SQL Trainer — Amvera Cloud Environment
# ============================================
# Copy this to Amvera Control Panel → Environment Variables
# or set via: amvera env set KEY=VALUE
# ============================================

# Required
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://your-app-name.runs.on-amvera.app

# Database (persists via /app/data volume mount)
DATABASE_PATH=/app/data/users.db

# Optional — SMTP (for password reset emails)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-user
# SMTP_PASS=your-pass
# SMTP_FROM=SQL Trainer <noreply@example.com>

# Optional — Push Notifications
# VAPID_PUBLIC_KEY=your-key
# VAPID_PRIVATE_KEY=your-key
# VAPID_SUBJECT=mailto:you@example.com
